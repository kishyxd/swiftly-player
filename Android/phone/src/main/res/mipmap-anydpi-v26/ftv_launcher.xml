<?xml version="1.0" encoding="utf-8"?>
<!--
    The FTV edition's app icon.

    Same structure as Swiftly's own (`ic_launcher.xml`): an adaptive icon with a background
    surface and the brand mark in front, plus a monochrome layer for themed icons.

    The mark is the FTV wordmark (fish forming the F, then TV), the same artwork the Plezy
    FTV build uses, cut out on transparency in `drawable-*/ftv_icon_foreground.png`.
    The wordmark is wide, so it is scaled to the full 72 dp safe zone and centred; a circle
    mask on a television clips the outer letters, which is why the mark sits in the middle
    of the safe zone rather than running to its edges.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ftv_icon_background" />
    <foreground android:drawable="@drawable/ftv_icon_foreground" />
    <monochrome android:drawable="@drawable/ftv_icon_foreground" />
</adaptive-icon>
