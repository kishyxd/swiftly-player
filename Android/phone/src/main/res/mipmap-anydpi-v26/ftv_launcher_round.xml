<?xml version="1.0" encoding="utf-8"?>
<!--
    The round variant of the FTV edition's app icon.

    The system masks an adaptive icon to whatever shape the launcher asks for, so the round
    icon is the same three layers as `ftv_launcher.xml`; the name only asks for the round
    cut-out on launchers that pick between a square and a round icon.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ftv_icon_background" />
    <foreground android:drawable="@drawable/ftv_icon_foreground" />
    <monochrome android:drawable="@drawable/ftv_icon_foreground" />
</adaptive-icon>
