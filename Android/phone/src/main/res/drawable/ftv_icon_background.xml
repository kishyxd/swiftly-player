<?xml version="1.0" encoding="utf-8"?>
<!--
    Background layer of the FTV edition's app icon.

    The Plezy/FTV icon is a full tile: a dark, slightly purple brand surface with the
    fish-and-TV wordmark on it. For the adaptive icon the tile is split, so the background
    carries the surface and the foreground carries the wordmark
    (`drawable-*/ftv_icon_foreground.png`, the same artwork cut out on transparency).

    Opaque and without rounding: the system mask cuts the corners, so a radius of its own
    would give a double edge. Same as Swiftly's own `ic_launcher_background`.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp" android:height="108dp"
    android:viewportWidth="108" android:viewportHeight="108">
    <path android:fillColor="#14111C" android:pathData="M0,0h108v108h-108z" />
</vector>
